{
  "name": "gladys-ticketmaster",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for Ticketmaster: concerts, shows and matches of followed artists, teams and venues, and around the house, in the Gladys calendar, with scene triggers (new date, reminder, ticket sale opening, canceled or moved), a scene action and dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-ticketmaster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-ticketmaster.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "ticketmaster",
    "concerts",
    "events",
    "tickets",
    "home-automation"
  ]
}
